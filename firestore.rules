/**
 * @file Firebase Security Rules for MediCheck AI.
 *
 * @description This ruleset enforces a strict user-ownership model using recursive wildcards.
 * All data for a user is siloed under `/users/{userId}`, where `{userId}` must match the 
 * authenticated user's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Rules for the /users/{userId} hierarchy.
     * 
     * Using {document=**} (a recursive wildcard) allows the owner to perform any 
     * read (get, list) or write (create, update, delete) operation on their own 
     * document and ALL nested subcollections (prescriptions, medications, chatMessages, etc.).
     * 
     * This ensures Authorization Independence and simplifies the rules significantly.
     */
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Explicit match for the user document itself to ensure full coverage.
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}