/**
 * @file Firebase Security Rules for MediCheck AI.
 *
 * @description This ruleset enforces a strict user-ownership model.
 * All data for a user is siloed under `/users/{userId}`.
 * Using a nested recursive wildcard ensures the owner has full access to 
 * their own document and ALL subcollections (prescriptions, medications, etc.).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the /users/{userId} hierarchy.
     * Matches the user document and any nested documents at any depth.
     */
    match /users/{userId} {
      // Allow the user to read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow the user to read/write any document in any subcollection under their ID
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}